APP_ENV=production
APP_DEBUG=false
APP_URL=https://travel.vazin.online
APP_KEY=change-this-to-a-random-64-character-secret
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vazin_online
DB_USERNAME=vazin_online
DB_PASSWORD=change-me
SESSION_SECURE=true
TRUSTED_PROXIES=
# Fail-closed outbound delivery gates. Enable deliberately only after staging approval.
EXTERNAL_DELIVERY_ENABLED=false
TELEGRAM_NETWORK_ENABLED=false
# Consented travel/visa notifications are separately fail-closed. Enable only
# after a tenant-specific bot, webhook, consent copy and staging test are ready.
TELEGRAM_ALERT_DELIVERY_ENABLED=false
# Telegram Business and assistant delivery require every parent gate above.
# Keep these false through build/staging; enable one capability at a time in the connection phase.
TELEGRAM_BUSINESS_ENABLED=false
TELEGRAM_ASSISTANT_DELIVERY_ENABLED=false
TELEGRAM_ASSISTANT_AUTOREPLY_ENABLED=false
# Read-only Web App preview. Never enable on an indexable production site.
TELEGRAM_ASSISTANT_PREVIEW_ENABLED=false
TELEGRAM_ASSISTANT_BATCH_SIZE=10
# Runtime paths are injected by managed deployment. Extensions default to storage/extensions.
# VAZINCMS_STORAGE_PATH=/var/lib/vazincms-runtime/site/data/storage
# VAZINCMS_UPLOADS_PATH=/var/lib/vazincms-runtime/site/data/uploads
# VAZINCMS_EXTENSIONS_PATH=/var/lib/vazincms-runtime/site/data/storage/extensions
VAZIN_ID_URL=https://id.vazin.online
VAZIN_ID_CLIENT_ID=
VAZIN_ID_MINIMUM_VERSION=5.4.3
# Comma-separated exact issuer hosts accepted by the Vazin ID module.
VAZIN_ID_ALLOWED_HOSTS=id.vazin.online
# Public project gateway used by the tenant-neutral Travel/Visa commerce bridge.
VAZINPAY_GATEWAY_URL=https://api.pay.vazin.online
VAZINPAY_API_KEY=
# Legacy consumer-Visa integration variables retained for compatibility.
VAZINPAY_API_URL=https://pay.vazin.online
VAZINPAY_PROJECT_API_KEY=
# Deprecated compatibility name; use VAZINPAY_PROJECT_API_KEY for legacy sites.
VAZINPAY_MERCHANT_API_KEY=
# Consumer Visa checkout is fail-closed. Enable only for a licensed seller
# after its contract, legal identity, provider flow and payment review pass.
VAZIN_VISA_DIRECT_SALES_ENABLED=false
TRAVEL_VISA_COMMERCIAL_ENABLED=false
# Set only after seller/operator approval and VazinPay credentials are provisioned.
TRAVEL_VISA_SELLER_ID=
VAZINPAY_WEBHOOK_SECRET=
TRAVEL_VISA_WEBHOOK_TENANTS=
VAZIN_ONLINE_URL=https://online.vazin.online
VAZIN_CONNECTOR_SECRET=change-me
