APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_KEY=change-this-to-a-random-64-character-secret

# Database: sqlite (zero-config default), pgsql, or mysql
DB_CONNECTION=sqlite
# DB_DATABASE=storage/database.sqlite

# PostgreSQL / MySQL configuration (when DB_CONNECTION=pgsql or mysql)
DB_HOST=127.0.0.1
DB_PORT=5432
# DB_DATABASE=vazincms
DB_USERNAME=vazincms
DB_PASSWORD=change-me

SESSION_SECURE=true
PAGE_CACHE_ENABLED=true
PAGE_CACHE_TTL=300
TRUSTED_PROXIES=

# Fail-closed outbound delivery gates. Enable deliberately only when needed.
EXTERNAL_DELIVERY_ENABLED=false
TELEGRAM_NETWORK_ENABLED=false
TELEGRAM_BUSINESS_ENABLED=false
TELEGRAM_ASSISTANT_DELIVERY_ENABLED=false
TELEGRAM_ASSISTANT_AUTOREPLY_ENABLED=false
TELEGRAM_ASSISTANT_PREVIEW_ENABLED=false
TELEGRAM_ASSISTANT_BATCH_SIZE=10

# Optional custom runtime paths (defaults to ./storage and ./public/uploads)
# VAZINCMS_STORAGE_PATH=/var/lib/vazincms/site/storage
# VAZINCMS_UPLOADS_PATH=/var/lib/vazincms/site/uploads
# VAZINCMS_EXTENSIONS_PATH=/var/lib/vazincms/site/storage/extensions

# Optional OIDC / Vazin ID Single Sign-On integration
VAZIN_ID_URL=https://id.vazin.online
VAZIN_ID_CLIENT_ID=
VAZIN_ID_MINIMUM_VERSION=5.4.3
VAZIN_ID_ALLOWED_HOSTS=id.vazin.online

# Optional VazinPay payment gateway module configuration
VAZINPAY_GATEWAY_URL=https://api.pay.vazin.online
VAZINPAY_API_URL=https://pay.vazin.online
VAZINPAY_API_KEY=
VAZINPAY_PROJECT_API_KEY=
VAZINPAY_WEBHOOK_SECRET=

# Optional managed deployment connector
VAZIN_ONLINE_URL=https://online.vazin.online
VAZIN_CONNECTOR_SECRET=
