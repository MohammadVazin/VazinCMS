[Unit]
Description=Vazin Online webhook delivery worker
After=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/vazin-online
ExecStart=/usr/bin/php /var/www/vazin-online/scripts/process-webhooks.php 50
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/vazin-online/storage

