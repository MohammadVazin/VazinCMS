[Unit]
Description=Vazin Online scheduled task worker
After=network.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/vazin-online
ExecStart=/usr/bin/php /var/www/vazin-online/scripts/run-scheduler.php
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/vazin-online/storage
